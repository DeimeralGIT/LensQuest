rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isValidSpot(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.title is string &&
             data.title.size() <= 100 &&
             data.description is string &&
             data.description.size() <= 1000 &&
             data.imageUrl is string &&
             data.location is map &&
             data.location.lat is number &&
             data.location.lng is number &&
             (data.get('aiTips', '') is string) &&
             (data.get('userName', '') is string) &&
             (data.get('tags', []) is list) &&
             data.keys().hasAll(['userId', 'title', 'description', 'imageUrl', 'location', 'createdAt', 'userName', 'tags', 'aiTips']) &&
             data.keys().size() == 9;
    }

    match /spots/{spotId} {
      // Allow public reading of all photography spots
      allow read: if true;
      
      allow create: if isSignedIn() && 
                      isValidId(spotId) && 
                      isValidSpot(incoming()) &&
                      incoming().createdAt == request.time;
      
      allow update: if isSignedIn() && 
                      isOwner(existing().userId) &&
                      isValidSpot(incoming()) &&
                      incoming().userId == existing().userId &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'location', 'imageUrl', 'tags', 'aiTips']);
      
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    match /users/{userId}/profile/public {
      allow read: if true;
      allow create, update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    // Allow connection test document
    match /_connection_test/{docId} {
      allow read: if true;
    }
  }
}
