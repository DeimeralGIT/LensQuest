rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isValidSpot(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.title is string &&
             data.title.size() > 0 &&
             data.title.size() <= 100 &&
             data.description is string &&
             data.description.size() <= 1000 &&
             data.imageUrl is string &&
             data.imageUrl.size() > 0 &&
             data.location is map &&
             data.location.lat is number &&
             data.location.lng is number &&
             data.tags is list &&
             data.get('userName', '') is string &&
             data.get('userPhotoURL', '') is string &&
             data.get('reviewCount', 0) is number &&
             data.get('averageRating', 0) is number;
    }

    match /spots/{spotId} {
      // Allow public reading of all photography spots
      allow read: if true;
      
      allow create: if isSignedIn() && 
                      isValidSpot(incoming());
      
      allow update: if isSignedIn() && 
                      request.auth.uid == resource.data.userId &&
                      isValidSpot(incoming());
      
      allow delete: if isSignedIn() && isOwner(existing().userId);

      // Reviews subcollection
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && request.auth.uid == resource.data.userId;
      }
    }

    match /reviews/{spotId}/reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() &&
                      reviewId == request.auth.uid &&
                      !exists(/databases/$(database)/documents/reviews/$(spotId)/reviews/$(request.auth.uid)) &&
                      request.resource.data.userId is string &&
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.rating is number &&
                      request.resource.data.text is string &&
                      request.resource.data.spotId is string;
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    match /users/{userId}/profile/public {
      allow read: if true;
      allow create, update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    match /imageReports/{reportId} {
      allow create: if request.resource.data.spotId is string &&
                      request.resource.data.ownerUserId is string &&
                      request.resource.data.ownerUserName is string &&
                      request.resource.data.imageUrl is string &&
                      request.resource.data.title is string &&
                      request.resource.data.reason is string &&
                      request.resource.data.reason.size() > 0 &&
                      request.resource.data.reason.size() <= 1000 &&
                      request.resource.data.reporterUserName is string &&
                      request.resource.data.status == 'pending' &&
                      (
                        (!isSignedIn() && request.resource.data.reporterUserId == null) ||
                        (isSignedIn() && request.resource.data.reporterUserId == request.auth.uid)
                      );
      allow read, update, delete: if false;
    }

    // Allow connection test document
    match /_connection_test/{docId} {
      allow read: if true;
    }
  }
}
