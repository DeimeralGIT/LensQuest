rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Entity Validations
    function isValidSpot(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.title is string &&
             data.title.size() <= 100 &&
             data.description is string &&
             data.description.size() <= 1000 &&
             data.imageUrl is string &&
             data.location is map &&
             data.location.lat is number &&
             data.location.lng is number &&
             (data.get('aiTips', '') is string) &&
             (data.aiTips.size() <= 2000) &&
             data.keys().hasAll(['userId', 'title', 'description', 'imageUrl', 'location', 'createdAt', 'userName', 'tags', 'aiTips']) &&
             data.keys().size() == 9;
    }

    function isValidUser(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.displayName is string &&
             data.displayName.size() <= 50 &&
             (data.get('photoURL', '') is string);
    }

    // 4. Match Blocks
    match /spots/{spotId} {
      allow get, list: if true; // Public reading
      
      allow create: if isSignedIn() && 
                      isValidId(spotId) && 
                      isValidSpot(incoming()) &&
                      incoming().createdAt == request.time;
      
      allow update: if isSignedIn() && 
                      isOwner(existing().userId) &&
                      isValidSpot(incoming()) &&
                      incoming().userId == existing().userId &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'location', 'imageUrl', 'tags', 'aiTips']);
      
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    match /users/{userId}/profile/public {
      allow get: if true;
      allow create, update: if isSignedIn() && isOwner(userId) && isValidUser(incoming());
      allow delete: if isSignedIn() && isOwner(userId);
    }
  }
}
